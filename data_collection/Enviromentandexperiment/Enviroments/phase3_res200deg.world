<?xml version="1.0" ?>
<!--
  PHASE 3 - PARAMETER OPTIMIZATION
  Configuration: 180 samples (2.0°), Mixed distances
  6 boxes distributed 360° at different ranges: 2m, 3m, 4.6m
-->
<sdf version="1.6">
  <world name="phase3_res200deg">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- ═════════════════════════════════════ -->
    <!--         ROOM WALLS (8m DISTANCE)      -->
    <!-- ═════════════════════════════════════ -->
    
    <model name="pared_norte">
      <static>true</static>
      <pose>0 8 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pared_sur">
      <static>true</static>
      <pose>0 -8 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pared_este">
      <static>true</static>
      <pose>8 0 1 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="pared_oeste">
      <static>true</static>
      <pose>-8 0 1 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ═════════════════════════════════════ -->
    <!--  6 BOXES AT MIXED DISTANCES 360°    -->
    <!--  B1,B4: 2m | B2,B5: 3m | B3,B6: 4.6m -->
    <!-- ═════════════════════════════════════ -->
    
    <!-- B1: 0°, 2m distance (Red) -->
    <model name="box1_target">
      <static>true</static>
      <pose>0.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- B2: 60°, 3m distance (Green) -->
    <model name="box2_target">
      <static>true</static>
      <pose>2.598 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- B3: 120°, 4.6m distance (Blue) -->
    <model name="box3_target">
      <static>true</static>
      <pose>3.984 -2.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- B4: 180°, 2m distance (Yellow) -->
    <model name="box4_target">
      <static>true</static>
      <pose>0.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.2 1</ambient>
            <diffuse>0.8 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- B5: 240°, 3m distance (Cyan) -->
    <model name="box5_target">
      <static>true</static>
      <pose>-2.598 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.8 1</ambient>
            <diffuse>0.2 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- B6: 300°, 4.6m distance (Magenta) -->
    <model name="box6_target">
      <static>true</static>
      <pose>-3.984 2.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.8 1</ambient>
            <diffuse>0.8 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═════════════════════════════════════ -->
    <!--     LIDAR: 180 SAMPLES (2.0°)        -->
    <!-- ═════════════════════════════════════ -->
    <model name="lidar_estatico">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <sensor name="hokuyo" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <visualize>true</visualize>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>180</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="lidar_plugin" filename="liblidar_plugin.so"/>
        </sensor>
      </link>
    </model>

  </world>
</sdf>

