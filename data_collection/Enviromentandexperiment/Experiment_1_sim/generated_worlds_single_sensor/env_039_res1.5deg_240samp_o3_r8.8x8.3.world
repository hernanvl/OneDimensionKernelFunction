<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_39">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 8.261229599764544 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>17.6838876699128 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>17.6838876699128 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_south"><static>true</static><pose>0 -8.261229599764544 1 0 0 0</pose>
