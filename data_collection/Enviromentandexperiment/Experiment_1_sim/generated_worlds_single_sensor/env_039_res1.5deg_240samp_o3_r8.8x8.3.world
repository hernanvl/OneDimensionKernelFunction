    <model name="wall_east"><static>true</static><pose>8.8419438349564 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>16.522459199529088 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>16.522459199529088 0.2 2</size></box></geometry>
