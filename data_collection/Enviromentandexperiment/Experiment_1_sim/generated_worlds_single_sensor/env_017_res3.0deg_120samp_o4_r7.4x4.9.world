<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_17">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 4.856485799925453 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>14.878520233427507 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>14.878520233427507 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_south"><static>true</static><pose>0 -4.856485799925453 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>14.878520233427507 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>14.878520233427507 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_east"><static>true</static><pose>7.439260116713753 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>9.712971599850906 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>9.712971599850906 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_west"><static>true</static><pose>-7.439260116713753 0 1 0 0 1.57</pose>
