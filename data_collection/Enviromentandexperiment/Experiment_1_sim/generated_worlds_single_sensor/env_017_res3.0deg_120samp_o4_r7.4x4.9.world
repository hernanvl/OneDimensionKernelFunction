      </collision><visual name="visual">
        <geometry><box><size>9.712971599850906 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <!-- SENSOR -->
    
    <model name="lidar_sensor">
      <static>true</static>
      <pose>-5.238500697785922 2.8552298846282724 0.4 0 0 0</pose>
      <link name="link">
        <sensor name="lidar" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <visualize>true</visualize>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <ray>
            <scan><horizontal>
              <samples>120</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal></scan>
            <range><min>0.15</min><max>20.0</max><resolution>0.01</resolution></range>
          </ray>
          <plugin name="lidar_plugin" filename="liblidar_plugin.so"/>
        </sensor>
      </link>
    </model>


    <!-- OBSTACLES -->
    
    <model name="obstacle_0">
      <static>true</static>
      <pose>-4.256219784726819 2.2846269854057066 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.37</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.37</radius><length>1.0</length></cylinder></geometry>
