    <!-- SENSOR -->
    
    <model name="lidar_sensor">
      <static>true</static>
      <pose>-1.4258761050069904 1.924871186077258 0.4 0 0 0</pose>
      <link name="link">
        <sensor name="lidar" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <visualize>true</visualize>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <ray>
            <scan><horizontal>
              <samples>90</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal></scan>
            <range><min>0.15</min><max>20.0</max><resolution>0.01</resolution></range>
          </ray>
          <plugin name="lidar_plugin" filename="liblidar_plugin.so"/>
        </sensor>
      </link>
    </model>


    <!-- OBSTACLES -->
    
    <model name="obstacle_0">
