<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_96">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 7.417936419375538 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>16.750314968050283 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>16.750314968050283 0.2 2</size></box></geometry>
