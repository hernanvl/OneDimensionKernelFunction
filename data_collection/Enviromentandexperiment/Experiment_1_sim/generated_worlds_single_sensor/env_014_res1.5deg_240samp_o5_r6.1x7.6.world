<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_14">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 7.636189795630946 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>12.103766253884448 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>12.103766253884448 0.2 2</size></box></geometry>
