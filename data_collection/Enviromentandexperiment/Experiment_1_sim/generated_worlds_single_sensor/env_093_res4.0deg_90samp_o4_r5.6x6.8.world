    <model name="wall_east"><static>true</static><pose>5.5572583772266935 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>13.557598482010338 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>13.557598482010338 0.2 2</size></box></geometry>
