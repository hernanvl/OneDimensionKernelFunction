<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_93">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 6.778799241005169 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>11.114516754453387 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>11.114516754453387 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_south"><static>true</static><pose>0 -6.778799241005169 1 0 0 0</pose>
      <link name="link"><collision name="collision">
