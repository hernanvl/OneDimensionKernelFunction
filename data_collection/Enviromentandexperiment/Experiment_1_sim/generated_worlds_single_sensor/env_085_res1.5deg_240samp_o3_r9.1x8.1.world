<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_85">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 8.092379115006887 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>18.15668492388853 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>18.15668492388853 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_south"><static>true</static><pose>0 -8.092379115006887 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>18.15668492388853 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>18.15668492388853 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_east"><static>true</static><pose>9.078342461944265 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>16.184758230013774 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>16.184758230013774 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_west"><static>true</static><pose>-9.078342461944265 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>16.184758230013774 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>16.184758230013774 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <!-- SENSOR -->
    
    <model name="lidar_sensor">
      <static>true</static>
      <pose>4.838122770989234 -2.8333180112192666 0.4 0 0 0</pose>
      <link name="link">
        <sensor name="lidar" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <visualize>true</visualize>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <ray>
            <scan><horizontal>
              <samples>240</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal></scan>
            <range><min>0.15</min><max>20.0</max><resolution>0.01</resolution></range>
          </ray>
          <plugin name="lidar_plugin" filename="liblidar_plugin.so"/>
        </sensor>
      </link>
    </model>


    <!-- OBSTACLES -->
    
    <model name="obstacle_0">
      <static>true</static>
      <pose>3.0643280087416116 6.128042173413176 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.95</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.95</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>-2.240071732781555 -1.483809863035738 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.43</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.43</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>0.9936694558691421 -3.6120859064049857 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.27 0.51 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.27 0.51 1.0</size></box></geometry>
        </visual>
      </link>
    </model>


  </world>
</sdf>
