<?xml version="1.0"?>
<sdf version="1.6">
  <world name="env_70">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- WALLS -->
    <model name="wall_north"><static>true</static><pose>0 5.35877332139291 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>14.687132016531134 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>14.687132016531134 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_south"><static>true</static><pose>0 -5.35877332139291 1 0 0 0</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>14.687132016531134 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>14.687132016531134 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_east"><static>true</static><pose>7.343566008265567 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>10.71754664278582 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>10.71754664278582 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <model name="wall_west"><static>true</static><pose>-7.343566008265567 0 1 0 0 1.57</pose>
      <link name="link"><collision name="collision">
        <geometry><box><size>10.71754664278582 0.2 2</size></box></geometry>
      </collision><visual name="visual">
        <geometry><box><size>10.71754664278582 0.2 2</size></box></geometry>
      </visual></link>
    </model>

    <!-- SENSOR -->
    
    <model name="lidar_sensor">
      <static>true</static>
      <pose>-2.283237973414626 -0.8264750361768893 0.4 0 0 0</pose>
      <link name="link">
        <sensor name="lidar" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <visualize>true</visualize>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <ray>
            <scan><horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal></scan>
            <range><min>0.15</min><max>20.0</max><resolution>0.01</resolution></range>
          </ray>
          <plugin name="lidar_plugin" filename="liblidar_plugin.so"/>
        </sensor>
      </link>
    </model>


    <!-- OBSTACLES -->
    
    <model name="obstacle_0">
      <static>true</static>
      <pose>3.9513171593508485 3.80953309241106 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.71 1.31 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.71 1.31 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>0.8516219821080329 -2.727323472120502 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.57</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.57</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>-0.08929232898009243 0.3574055275465522 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.79</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.79</radius><length>1.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>


  </world>
</sdf>
